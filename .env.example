# Copy to `.env` and fill in. `.env` is gitignored and is read both by
# `npm start` (lib/env.js) and by Docker Compose.

# Access key required for POST /api/convert generation requests in the
# `x-converter-token` header. Defaults to
# 
CONVERTER_TOKEN=

# Access key for the browser dashboard. Anyone without it is redirected to the
# unlock page. The API is NOT gated by this - server-to-server callers keep
# working - so treat it as "who may use the UI", not "who may use the service".
# Leave unset and the server generates one, persists it under
# .build-workspace/dashboard-token and prints it at boot.
DASHBOARD_TOKEN=

# How long a browser stays unlocked, in seconds (default 43200 = 12h).
DASHBOARD_SESSION_SECONDS=43200

PORT=3000
MAX_UPLOAD_MB=500
BUILD_CONCURRENCY=10
JOB_RETENTION=20
