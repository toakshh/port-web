#!/bin/sh
# One-command environment setup for macOS and Linux.
# Bootstraps Node.js if it is missing, then hands off to scripts/setup.js.
set -e
DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is required and was not found."
  if command -v brew >/dev/null 2>&1; then
    echo "Installing Node.js with Homebrew..."
    brew install node
  elif command -v apt-get >/dev/null 2>&1; then
    echo "Installing Node.js with apt..."
    sudo apt-get update && sudo apt-get install -y nodejs npm
  elif command -v dnf >/dev/null 2>&1; then
    sudo dnf install -y nodejs npm
  elif command -v pacman >/dev/null 2>&1; then
    sudo pacman -Sy --noconfirm nodejs npm
  else
    echo "Install Node.js 18 or newer from https://nodejs.org and re-run this script."
    exit 1
  fi
fi

exec node "$DIR/scripts/setup.js" "$@"
